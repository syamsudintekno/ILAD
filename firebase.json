{
  "functions": {
    "source": ".ilad-functions",
    "runtime": "python313",
    "ignore": ["venv", "__pycache__", "**/__pycache__/**", ".env*"]
  },
  "firestore": { "rules": "firebase/firestore.rules" },
  "storage": { "rules": "firebase/storage.rules" },
  "emulators": {
    "auth": { "port": 9099 },
    "functions": { "port": 5001 },
    "firestore": { "port": 8080 },
    "storage": { "port": 9199 },
    "ui": { "enabled": false }
  }
}
